table DimDate
	lineageTag: 4220d50a-2b23-4df3-8d18-d760ec3b5471
	dataCategory: Time

	column Date
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 63697abd-0b87-415d-b890-64a4e7c4b26b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

