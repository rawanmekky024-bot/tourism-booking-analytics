	column YearMonthSort
		formatString: 0
		lineageTag: aae3d686-b054-4183-9361-a3266149d742
		summarizeBy: none
		isNameInferred
		sourceColumn: [YearMonthSort]

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        MIN(Bookings[Check_in_Date]),
				        MAX(Bookings[Check_in_Date])
				    ),
				    "Year", YEAR([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Month Number", MONTH([Date]),
				    "Year-Month", FORMAT([Date], "yyyy-MM"),
				    "YearMonthSort", YEAR([Date]) * 100 + MONTH([Date])
				)

	annotation PBI_Id = a2c80caa9ecb467bb1639a0e9b6edfcc

