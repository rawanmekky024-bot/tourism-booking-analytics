table Bookings
	lineageTag: 972ab99a-dc98-4ee6-8a64-167563321e8a

	measure 'Total Bookings' = ```
			
			DISTINCTCOUNT(Bookings[Booking_ID])
			
			```
		formatString: 0
		lineageTag: 79285b47-de52-4963-8386-c2444c74bf7c

	measure 'Cancelled Bookings' = ```
			
			CALCULATE([Total Bookings], Bookings[Booking_Cancelled] = "Yes")
			
			```
		formatString: 0
		lineageTag: 82d2b694-f726-4eca-b9e1-f86490ebe69c

	measure 'Cancellation Rate' = ```
			
			DIVIDE([Cancelled Bookings], [Total Bookings], 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4101b539-1ea3-4306-9d9f-2bf395f3aa22

	measure 'Average Satisfaction' = AVERAGE(Bookings[Guest_Satisfaction_Score])
		formatString: 0.00
		lineageTag: b62cb23b-da4f-4e56-8d13-ea515e6cd8a0

	measure 'Average Stay Cost' = AVERAGE(Bookings[Estimated_Stay_Cost_USD])
		formatString: #,0.00
		lineageTag: 47f9c4a7-d6e1-4110-9c56-d660a7087219

	measure 'Estimated Completed-Stay Revenue' =
			
			SUM(Bookings[Estimated Revenue from Completed Stays])
		lineageTag: 413071ee-d790-4eef-b6fe-a6217adcf34b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Check-in Delay' = AVERAGE(Bookings[Check_in_Delay_Minutes])
		lineageTag: d34fc410-fbc7-4713-a36f-c1c61d65e7cb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Repeat Visitor Rate' =
			
			DIVIDE(
			    CALCULATE([Total Bookings], Bookings[Repeat_Visitor] = "Yes"),
			    CALCULATE([Total Bookings], Bookings[Repeat_Visitor] IN {"Yes", "No"}),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 61b34715-0916-4595-9923-d93d8557cae3

	measure 'Bookings Above Min Satisfaction' =
			
			VAR MinScore = [Minimum Satisfaction Value]
			RETURN
			    CALCULATE(
			        [Total Bookings],
			        FILTER(Bookings, Bookings[Guest_Satisfaction_Score] >= MinScore)
			    )
		formatString: 0
		lineageTag: cd59ecfe-4aa4-4c50-bd80-ab447181327d

